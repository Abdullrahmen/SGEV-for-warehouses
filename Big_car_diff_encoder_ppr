#include <WiFi.h>
#include <WebServer.h>

#define NUM_MOTORS 4

float left_ref_cmd  = 60.0;   
float right_ref_cmd = 60.0;

float left_ref_ramp  = 0.0;   
float right_ref_ramp = 0.0;
  
const float accelLimit = 60.0;
const float decelLimit = 60.0;

bool motorActive = false;

/* ================= USER PARAMETERS ================= */
const float Ts = 0.01;   
const float PWM_MAX = 250.0;
const float PWM_MIN = -250.0;
const float DEAD_ZONE = 80.0;
const int COUNTS_PER_REV[NUM_MOTORS] = {
    880, // FR (0)
    880, // BR (1)
    240, // FL (2)
    240  // BL (3)
};

float speed[4] = {0};
float speed_filt[4] = {0};
float speed_prev[4] = {0};
// FR, BR, FL, BL --> Front Right, Back Right, Front Left, Back Left
/* Encoder pins */
const int ENC_A[NUM_MOTORS] = {34, 35, 18, 33};
const int ENC_B[NUM_MOTORS] = {39, 36, 21, 19};

/* Motor driver pins */
const int DIR[NUM_MOTORS] = {13, 15, 16, 17};

const int PWM_PINS[NUM_MOTORS] = {25, 26, 27, 14};
const int PWM_CHANNELS[NUM_MOTORS] = {0, 1, 2, 3};
const int PWM_FREQ = 15000;
const int PWM_RES = 8;

/* ================= PI CONTROLLER ================= */
typedef struct {
  float Kp;
  float Ki;
  float ui;
  float e;
  float u;
} PI_Controller;

PI_Controller motorPI[NUM_MOTORS] = {
  {1.53, 7.9, 0, 0, 0},
  {1.621, 7.9, 0, 0, 0},
  {1.247, 7.85, 0, 0, 0},
  {1.579, 7.91, 0, 0, 0}
};

/* ================= WI-FI STATION ================= */
const char* ssid = "ROBOT b NET?";
const char* password = "RoBoT12345678#";

WebServer server(80);

// HTML page with two sliders and Go/Stop buttons
const char htmlPage[] PROGMEM = R"rawliteral(
