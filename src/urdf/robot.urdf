<?xml version="1.0"?>
<robot name="simple_4wd">

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.033"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.25 0.20 0.08"/></geometry>
      <material name="gray"><color rgba="0.7 0.7 0.7 1"/></material>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.25 0.20 0.08"/></geometry>
      <origin xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="front_left_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_left_wheel"/>
    <origin xyz="0.10 0.115 -0.033"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_right_wheel"/>
    <origin xyz="0.10 -0.115 -0.033"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rear_left_wheel"/>
    <origin xyz="-0.10 0.115 -0.033"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.025"/></geometry>
      <origin rpy="1.5708 0 0"/>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rear_right_wheel"/>
    <origin xyz="-0.10 -0.115 -0.033"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 0.8 1"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0.0 0.0 0.08"/>
  </joint>

</robot>
